# Gemini API Key (Required in production)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Network & Timeout settings
GEMINI_TIMEOUT_SECONDS=15.0

# CORS Origins (Comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (SlowAPI format: e.g. 60/minute)
RATE_LIMIT_PER_MINUTE=60/minute

# Cache TTL (in seconds)
CACHE_TTL_SECONDS=300

# Environment (development, testing, production)
ENVIRONMENT=development
